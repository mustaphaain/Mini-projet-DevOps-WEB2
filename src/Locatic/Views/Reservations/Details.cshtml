@model Locatic.Models.Reservation

<h1>Détails de la réservation</h1>

<div>
    <strong>Client :</strong> @Model.Client?.Nom<br />
    <strong>Voiture :</strong> @Model.Voiture?.Immatriculation<br />
    <strong>Modèle :</strong> @Model.Voiture?.Modele?.Nom<br />
    <strong>Marque :</strong> @Model.Voiture?.Modele?.Marque?.Nom<br />
    <strong>Date début :</strong> @Model.DateDebut.ToShortDateString()<br />
    <strong>Date fin :</strong> @Model.DateFin.ToShortDateString()<br />
    <strong>Prix total :</strong> @Model.PrixTotal.ToString("0.00")<br />
</div>

<p>
    <a asp-action="Edit" asp-route-id="@Model.Id">Modifier</a> |
    <a asp-action="Index">Retour à la liste</a>
</p>