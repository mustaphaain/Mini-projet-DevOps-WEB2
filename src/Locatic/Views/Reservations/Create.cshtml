@model Locatic.Models.Reservation

<h1>Créer réservation</h1>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="validation-summary-valid"></div>

    <label>Client</label>
    <select asp-for="ClientId" asp-items="ViewBag.Clients"></select>
    <span asp-validation-for="ClientId"></span>

    <br><br>

    <label>Voiture</label>
    <select asp-for="VoitureId" asp-items="ViewBag.Voitures"></select>
    <span asp-validation-for="VoitureId"></span>

    <br><br>

    <label>Date début</label>
    <input asp-for="DateDebut" type="date" />
    <span asp-validation-for="DateDebut"></span>

    <br><br>

    <label>Date fin</label>
    <input asp-for="DateFin" type="date" />
    <span asp-validation-for="DateFin"></span>

    <br><br>

    <button type="submit">Réserver</button>
</form>